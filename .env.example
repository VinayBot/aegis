# Copy to backend/.env (read by the gateway) or export in the shell. Every variable is optional.

# production (default): admin key required for the control plane, chaos refused
# dev: loopback callers are the local operator; scripts/dev.sh sets this
AEGIS_ENV=production
# admin credential for the control plane (in production use a secret store, not a file)
AEGIS_ADMIN_KEY=
# production ignores plaintext keys in the YAML (only sha256: entries); 1 accepts them (local demo)
AEGIS_ALLOW_PLAINTEXT_KEYS=0
# fault injection, dev only (ignored in production)
AEGIS_CHAOS_ENABLED=0

AEGIS_REDIS_URL=redis://127.0.0.1:6379/0
AEGIS_OTLP_ENDPOINT=http://127.0.0.1:4318
AEGIS_LOG_FORMAT=json

# where the model servers are (the YAML reads it): host.docker.internal from a container
AEGIS_MODEL_HOST=127.0.0.1
# the LiteLLM proxy's key (the gateway reads it from the environment, never the YAML)
LITELLM_MASTER_KEY=sk-aegis-local

# Langfuse (cloud or `make langfuse-up`): traces are also exported there when both keys are set
AEGIS_LANGFUSE_HOST=http://localhost:3100
AEGIS_LANGFUSE_PUBLIC_KEY=
AEGIS_LANGFUSE_SECRET_KEY=
